{
	"name": "n8n-nodes-mockingbird",
	"version": "0.2.0",
	"description": "n8n community nodes for the Mockingbird mock APIs",
	"license": "MIT",
	"homepage": "https://github.com/n8n-io/n8n-nodes-mockingbird",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Jamie Madden",
		"email": "jamie.madden@n8n.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8n-io/n8n-nodes-mockingbird.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"generate": "node scripts/generate.cjs",
		"test": "npm run build && node --test test/*.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MockingbirdApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Commerce/MockingbirdCommerce.node.js",
			"dist/nodes/Support/MockingbirdSupport.node.js",
			"dist/nodes/People/MockingbirdPeople.node.js",
			"dist/nodes/FinanceSecurity/MockingbirdFinanceSecurity.node.js",
			"dist/nodes/Platform/MockingbirdPlatform.node.js",
			"dist/nodes/Fun/MockingbirdFun.node.js"
		]
	},
	"devDependencies": {
		"@devlikeapro/n8n-openapi-node": "^0.1.4",
		"@n8n/node-cli": "*",
		"eslint": "10.15.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
