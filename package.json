{
	"name": "n8n-nodes-mockingbird",
	"version": "0.1.0",
	"description": "n8n community nodes for the Mockingbird mock APIs",
	"license": "MIT",
	"homepage": "https://github.com/n8n-io/n8n-nodes-mockingbird",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Jamie Madden",
		"email": "jamie.madden@n8n.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/n8n-io/n8n-nodes-mockingbird.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"generate": "node scripts/generate.cjs",
		"test": "npm run build && node --test test/*.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MockingbirdApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ProductCatalogue/MockingbirdProductCatalogue.node.js",
			"dist/nodes/Helpdesk/MockingbirdHelpdesk.node.js",
			"dist/nodes/Orders/MockingbirdOrders.node.js",
			"dist/nodes/Weather/MockingbirdWeather.node.js",
			"dist/nodes/ExchangeRates/MockingbirdExchangeRates.node.js",
			"dist/nodes/Quotes/MockingbirdQuotes.node.js",
			"dist/nodes/Utilities/MockingbirdUtilities.node.js",
			"dist/nodes/CrmLite/MockingbirdCrmLite.node.js",
			"dist/nodes/FunPack/MockingbirdFunPack.node.js",
			"dist/nodes/PeopleHr/MockingbirdPeopleHr.node.js",
			"dist/nodes/TimeOff/MockingbirdTimeOff.node.js",
			"dist/nodes/Inventory/MockingbirdInventory.node.js",
			"dist/nodes/BatchJobs/MockingbirdBatchJobs.node.js",
			"dist/nodes/EventStream/MockingbirdEventStream.node.js",
			"dist/nodes/FraudDetection/MockingbirdFraudDetection.node.js",
			"dist/nodes/SecurityMonitor/MockingbirdSecurityMonitor.node.js",
			"dist/nodes/ProductReviews/MockingbirdProductReviews.node.js",
			"dist/nodes/WebhookHub/MockingbirdWebhookHub.node.js",
			"dist/nodes/DocumentStore/MockingbirdDocumentStore.node.js",
			"dist/nodes/Sandbox/MockingbirdSandbox.node.js",
			"dist/nodes/MeetingRooms/MockingbirdMeetingRooms.node.js",
			"dist/nodes/KnowledgeBase/MockingbirdKnowledgeBase.node.js",
			"dist/nodes/AgentTools/MockingbirdAgentTools.node.js",
			"dist/nodes/Classifier/MockingbirdClassifier.node.js",
			"dist/nodes/Assessments/MockingbirdAssessments.node.js"
		]
	},
	"devDependencies": {
		"@devlikeapro/n8n-openapi-node": "^0.1.4",
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
